# ==========================================
# Lab Storage Manager - .env 示例模板
# ==========================================
# 使用方式：
# 1) 复制本文件为 .env
# 2) 按注释填写生产参数
# 3) 重启后端进程使配置生效
# 注意：不要把真实 .env 提交到 Git 仓库
#
# 生产环境必填项：
# [必填] ENV
# [必填] CORS_ORIGINS
# [必填] DEFAULT_ADMIN_PASSWORD
# [必填/条件] ALGORITHM=RS256 时需可用私钥/公钥文件；ALGORITHM=HS256 时需 SECRET_KEY

# ==========================================
# 应用基础配置
# ==========================================
# 应用名称（主要用于日志/展示）
APP_NAME="Lab Storage Manager"

# 应用版本号（可用于运维标记）
APP_VERSION="0.1.0"

# 是否开启调试模式：
# true  = 输出更多调试信息（开发环境）
# false = 生产环境建议
DEBUG=false

# 运行环境：
# development / dev = 开发模式
# production        = 生产模式（建议线上使用）
# [必填]
ENV=production

# ==========================================
# CORS 与反向代理
# ==========================================
# 前端来源白名单，JSON 数组字符串格式
# 示例：
# CORS_ORIGINS="[\"https://a.com\", \"https://b.com\"]"
# [必填]（生产请改成你的真实前端域名）
CORS_ORIGINS="[\"https://a.com\"]"

# 是否信任反向代理头（X-Forwarded-*）：
# 仅在确认所有流量都经过受信反向代理时设为 true
# 默认 false，避免头部伪造风险
TRUST_PROXY_HEADERS=false

# ==========================================
# 数据库
# ==========================================
# SQLite 连接串（当前项目默认 SQLite）
# 生产建议使用绝对路径并做好备份策略
DATABASE_URL="sqlite:///./lab_inventory.db"

# ==========================================
# JWT 认证配置
# ==========================================
# JWT 算法：
# RS256 = 非对称密钥（生产推荐）
# HS256 = 对称密钥（需强 SECRET_KEY）
# [必填/条件] 默认 RS256；改 HS256 必须设置 SECRET_KEY
ALGORITHM="RS256"

# RS256 私钥路径（签发 token）
# [必填/条件] 当 ALGORITHM=RS256 时，路径对应文件必须存在
PRIVATE_KEY_PATH=".keys/private.pem"

# RS256 公钥路径（校验 token）
# [必填/条件] 当 ALGORITHM=RS256 时，路径对应文件必须存在
PUBLIC_KEY_PATH=".keys/public.pem"

# HS256 时必须设置高强度 SECRET_KEY
# RS256 模式下可留空
# [必填/条件] 当 ALGORITHM=HS256 时必填
SECRET_KEY=""

# Access Token 过期时间（分钟）
# 10080 = 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# Redis 配置（支持与 WordPress 共用实例）
# ==========================================
# Redis 地址
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Redis 逻辑库编号：
# 建议 WordPress 用 DB0，本项目用 DB1（便于观察和隔离）
REDIS_DB=1

# Redis 密码（生产必填，必须为高强度随机值）
REDIS_PASSWORD=""

# 本项目 Redis key 前缀（重要）
# 建议固定 lsm，避免与其他系统 key 冲突
REDIS_KEY_PREFIX="lsm"

# ==========================================
# 会话与设备限制
# ==========================================
# 会话有效期（小时）
SESSION_EXPIRE_HOURS=72

# 是否强制校验登录 IP 一致：
# true  = 安全更高，但切换网络可能频繁掉线
# false = 体验更好（默认）
SESSION_STRICT_IP=false

# 单用户允许的最大 IP 数量
MAX_IP_PER_USER=5

# 单用户允许的最大设备数量
MAX_DEVICE_PER_USER=10

# ==========================================
# 上传与图片限制
# ==========================================
# 单文件最大体积（MB）
MAX_FILE_SIZE_MB=10

# 单次请求总上传体积（MB）
# 建议与 Nginx client_max_body_size 保持一致
MAX_UPLOAD_REQUEST_SIZE_MB=12

# 允许上传的 MIME 类型（逗号分隔）
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# 图片最大宽/高（像素）
MAX_IMAGE_WIDTH=800
MAX_IMAGE_HEIGHT=800

# 图片压缩后最大体积（KB）
MAX_IMAGE_SIZE_KB=100

# 上传限流：窗口内最大次数
UPLOAD_RATE_LIMIT_COUNT=10

# 上传限流：时间窗口（秒）
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300

# ==========================================
# 公告模块限制
# ==========================================
# 单管理员最多公告数
MAX_TOTAL_ANNOUNCEMENTS=10

# 单管理员最多可见公告数
MAX_VISIBLE_ANNOUNCEMENTS=5

# ==========================================
# 第三方翻译服务（可选）
# ==========================================
# 不使用牛翻 API 可留空
NIUTRANS_APPID=""
NIUTRANS_APIKEY=""

# ==========================================
# 默认管理员（首次启动初始化）
# ==========================================
# 默认管理员用户名
DEFAULT_ADMIN_USERNAME="admin"

# 默认管理员密码（强烈建议首次启动后立即修改）
# [必填] 不填写会导致后端启动时初始化失败
DEFAULT_ADMIN_PASSWORD=""

# 默认管理员姓名
DEFAULT_ADMIN_FULL_NAME="系统管理员"
