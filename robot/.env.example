# 企业微信智能机器人 / 微信客服配置模板
#
# 使用方式：
# 1) 复制本文件为 robot/.env
# 2) 按实际部署模式填写密钥、URL 和端口
# 3) 重启对应 robot 进程
#
# 注意：
# - 不要把真实 robot/.env 提交到 Git 仓库
# - 生产环境必须设置 WECOM_AIBOT_TOKEN_ENCRYPTION_KEY
# - 微信客服入口也复用该密钥保存绑定 token
# - 模板默认使用 WECOM_AIBOT_* 变量；如改用 OPENAI_* 或 MINIMAX_* 别名，
#   需要删除或注释对应的空 WECOM_AIBOT_* 行，避免空值覆盖别名

# ==========================================
# 运行环境与 token 存储
# ==========================================
# development / dev / local / test / testing = 开发环境
# production = 生产环境
WECOM_AIBOT_ENV=production

# 生产环境必填：用于加密保存机器人绑定的 LabStorageManager access token
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
WECOM_AIBOT_TOKEN_ENCRYPTION_KEY=

# 仅开发环境有效；生产环境不要依赖明文 token 存储
WECOM_AIBOT_ALLOW_PLAINTEXT_TOKEN_STORAGE=false

# 机器人状态库：消息去重、会话绑定、已生成回复等
WECOM_AIBOT_STATE_DB=robot/wecom_aibot_state.db

# ==========================================
# 企业微信智能机器人基础配置
# ==========================================
# 推荐先使用 websocket 模式；没有公网 HTTPS 时也能运行
WECOM_AIBOT_MODE=websocket

# WebSocket 模式
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com

# Webhook 模式：需要在企业微信后台配置 URL、Token、EncodingAESKey
WECOM_AIBOT_TOKEN=
WECOM_AIBOT_ENCODING_AES_KEY=
WECOM_AIBOT_RECEIVE_ID=
WECOM_AIBOT_WEBHOOK_HOST=0.0.0.0
WECOM_AIBOT_WEBHOOK_PORT=8010
WECOM_AIBOT_CALLBACK_MAX_BODY_BYTES=1048576

# 机器人回复参数
WECOM_AIBOT_SEARCH_LIMIT=5
WECOM_AIBOT_LOW_STOCK_THRESHOLD=0.2
WECOM_AIBOT_WELCOME_TEXT=你好，我是实验室库存助手。可以问我库存、位置、低库存和借用状态。

# ==========================================
# LabStorageManager MCP / CLI 接入
# ==========================================
# MCP 服务调用 LabStorageManager API 的地址
LSM_MCP_BASE_URL=http://127.0.0.1:8000/api

# CLI 子进程请求超时（秒）
LSM_MCP_CLI_TIMEOUT=5

# MCP 服务令牌；用于 lsm_mcp 以服务身份调用 CLI
# 当前机器人查询默认使用绑定用户 token；仅启用服务身份工具时填写
LSM_MCP_SERVICE_TOKEN=

# 机器人访问本地 MCP Streamable HTTP 的地址
# 可选别名：WECOM_AIBOT_MCP_URL
LSM_MCP_URL=http://127.0.0.1:8030/mcp

# 机器人调用 MCP 的超时（秒）
# 可选别名：LSM_MCP_TIMEOUT_SECONDS
WECOM_AIBOT_MCP_TIMEOUT_SECONDS=15

# ==========================================
# LLM 意图规划器（可选）
# ==========================================
# 不配置 API Key 时走规则兜底
# 可选别名：OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL / OPENAI_RESPONSES_URL
WECOM_AIBOT_LLM_API_KEY=
WECOM_AIBOT_LLM_MODEL=gpt-5
WECOM_AIBOT_LLM_BASE_URL=
WECOM_AIBOT_LLM_RESPONSES_URL=https://api.openai.com/v1/responses
WECOM_AIBOT_LLM_TIMEOUT_SECONDS=8
WECOM_AIBOT_LLM_MAX_OUTPUT_TOKENS=400

# ==========================================
# MiniMax Token Plan MCP（可选）
# ==========================================
# web_search 只用于化学名称/别名辅助确定 CAS，不接入图片理解
# 可选别名：MINIMAX_API_KEY / MINIMAX_API_HOST
WECOM_AIBOT_WEB_SEARCH_ENABLED=true
WECOM_AIBOT_MINIMAX_API_KEY=
WECOM_AIBOT_MINIMAX_API_HOST=https://api.minimaxi.com
WECOM_AIBOT_MINIMAX_MCP_COMMAND=uvx
WECOM_AIBOT_MINIMAX_MCP_TIMEOUT_SECONDS=25

# ==========================================
# 微信客服入口（个人微信用户，一对一会话）
# ==========================================
# 启动入口：python robot/run_wechat_kf_webhook.py
# 回调地址：https://your-domain.example.com/wechat/kf/callback
WECHAT_KF_CORP_ID=
WECHAT_KF_SECRET=
WECHAT_KF_TOKEN=
WECHAT_KF_ENCODING_AES_KEY=
WECHAT_KF_RECEIVE_ID=
WECHAT_KF_OPEN_KFID=
WECHAT_KF_API_BASE_URL=https://qyapi.weixin.qq.com
WECHAT_KF_STATE_DB=robot/wecom_aibot_state.db
WECHAT_KF_WEBHOOK_HOST=0.0.0.0
WECHAT_KF_WEBHOOK_PORT=8020
WECHAT_KF_BIND_BASE_URL=
WECHAT_KF_BIND_TOKEN_TTL_MINUTES=10
WECHAT_KF_CALLBACK_MAX_BODY_BYTES=1048576
WECHAT_KF_SYNC_LIMIT=100
WECHAT_KF_SYNC_MAX_PAGES=5
WECHAT_KF_RATE_LIMIT_MAX_MESSAGES=3
WECHAT_KF_RATE_LIMIT_WINDOW_SECONDS=10
WECHAT_KF_REPLY_DEBOUNCE_SECONDS=1
