# ==========================================
# Lab Storage Manager - .env 示例模板
# ==========================================
# 使用方式：
# 1) 复制本文件为 .env
# 2) 按注释填写生产参数
# 3) 重启后端进程使配置生效
# 注意：不要把真实 .env 提交到 Git 仓库
#
# 生产环境必填项：
# [必填] ENV
# [必填] CORS_ORIGINS
# [必填] DEFAULT_ADMIN_PASSWORD
# [必填/条件] ALGORITHM=RS256 时需可用私钥/公钥文件；ALGORITHM=HS256 时需 SECRET_KEY

# ==========================================
# 应用基础配置
# ==========================================
# 应用名称（主要用于日志/展示）
APP_NAME="Lab Storage Manager"

# 应用版本号（可用于运维标记）
APP_VERSION="0.1.0"

# 缓存失效版本号：
# 代码更新后如果希望强制清理前后端缓存并要求所有用户重新登录，递增此值
# 若留空，后端会自动回退到 APP_VERSION
CACHE_VERSION=""

# 是否开启调试模式：
# true  = 输出更多调试信息（开发环境）
# false = 生产环境建议
DEBUG=false

# 运行环境：
# development / dev = 开发模式
# production        = 生产模式（建议线上使用）
# [必填]
ENV=production

# ==========================================
# CORS 与反向代理
# ==========================================
# 前端来源白名单，JSON 数组字符串格式
# 示例：
# CORS_ORIGINS="[\"https://a.com\", \"https://b.com\"]"
# [必填]（生产请改成你的真实前端域名）
CORS_ORIGINS="[\"https://a.com\"]"

# 是否信任反向代理头（X-Forwarded-*）：
# Docker Compose 生产部署默认建议 true，用于识别外层 HTTPS 代理
# 本地开发、直连后端、或没有可信反向代理时设为 false
TRUST_PROXY_HEADERS=true

# ==========================================
# 数据库
# ==========================================
# SQLite 连接串（当前项目默认 SQLite）
# 本地默认使用项目根目录；Docker Compose 生产默认覆盖为 /data/lab_inventory.db
# 生产备份前建议 checkpoint，或同时备份 db/db-wal/db-shm
DATABASE_URL="sqlite:///./lab_inventory.db"

# 搜索日志库目录（query_logs.db）
# Docker Compose 生产默认覆盖为 /data/logs
QUERY_LOG_DIR="logs"

# ==========================================
# 数据库日志归档
# ==========================================
# 是否启用后端内置定时归档：
# true  = 后端启动后按周期运行 app.archive_logs / app.archive_query_logs
# false = 不启用，仍可手动运行 python -m app.archive_logs --dry-run
ARCHIVE_SCHEDULER_ENABLED=false

# 归档周期（小时）；仅在未设置 ARCHIVE_RUN_AT_TIME 时生效
ARCHIVE_INTERVAL_HOURS=24

# 后端启动后首次归档前的延迟（秒）
# 仅在未设置 ARCHIVE_RUN_AT_TIME 时生效
ARCHIVE_STARTUP_DELAY_SECONDS=300

# 按服务器本地系统时间执行归档（HH:MM 或 HH:MM:SS）
# 留空时使用 ARCHIVE_STARTUP_DELAY_SECONDS + ARCHIVE_INTERVAL_HOURS 周期模式
ARCHIVE_RUN_AT_TIME=""

# 可选：设置后每周在指定星期执行，未设置则每天执行
# 支持 0-6（0=Monday, 6=Sunday）或 mon/tue/wed/thu/fri/sat/sun
ARCHIVE_RUN_WEEKDAY=""

# 归档库输出目录
# Docker Compose 生产建议与 QUERY_LOG_DIR 一致，例如 /data/logs
ARCHIVE_OUTPUT_DIR="logs"

# ==========================================
# JWT 认证配置
# ==========================================
# JWT 算法：
# RS256 = 非对称密钥（生产推荐）
# HS256 = 对称密钥（需强 SECRET_KEY）
# [必填/条件] 默认 RS256；改 HS256 必须设置 SECRET_KEY
ALGORITHM="RS256"

# RS256 私钥路径（签发 token）
# [必填/条件] 当 ALGORITHM=RS256 时，路径对应文件必须存在
PRIVATE_KEY_PATH=".keys/private.pem"

# RS256 公钥路径（校验 token）
# [必填/条件] 当 ALGORITHM=RS256 时，路径对应文件必须存在
PUBLIC_KEY_PATH=".keys/public.pem"

# HS256 时必须设置高强度 SECRET_KEY
# RS256 模式下可留空
# [必填/条件] 当 ALGORITHM=HS256 时必填
SECRET_KEY=""

# Access Token 过期时间（分钟）
# 10080 = 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# Redis 配置（支持与 WordPress 共用实例）
# ==========================================
# Redis 地址
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Redis 逻辑库编号：
# 建议 WordPress 用 DB0，本项目用 DB1（便于观察和隔离）
REDIS_DB=1

# Redis 密码：
# - Redis 仅监听 127.0.0.1 时可留空
# - Redis 对外监听或跨机器访问时必须设置高强度密码
REDIS_PASSWORD=""

# 本项目 Redis key 前缀（重要）
# 建议固定 lsm，避免与其他系统 key 冲突
REDIS_KEY_PREFIX="lsm"

# ==========================================
# 会话与设备限制
# ==========================================
# 会话有效期（小时）
SESSION_EXPIRE_HOURS=72

# 是否强制校验登录 IP 一致：
# true  = 安全更高，但切换网络可能频繁掉线
# false = 体验更好（默认）
SESSION_STRICT_IP=false

# 单用户允许的最大 IP 数量
MAX_IP_PER_USER=5

# 单用户允许的最大设备数量
MAX_DEVICE_PER_USER=10

# ==========================================
# 上传与图片限制
# ==========================================
# 单文件最大体积（MB）
MAX_FILE_SIZE_MB=10

# 单次请求总上传体积（MB）
# 与生产 Nginx client_max_body_size 保持一致
# 公告图片和头像仍由业务代码单独限制为 5MB
MAX_UPLOAD_REQUEST_SIZE_MB=12

# 允许上传的 MIME 类型，JSON 数组字符串格式
ALLOWED_IMAGE_TYPES="[\"image/jpeg\", \"image/png\", \"image/webp\"]"

# 图片最大宽/高（像素）
MAX_IMAGE_WIDTH=800
MAX_IMAGE_HEIGHT=800

# 图片压缩后最大体积（KB）
MAX_IMAGE_SIZE_KB=100

# 上传限流：窗口内最大次数
UPLOAD_RATE_LIMIT_COUNT=10

# 上传限流：时间窗口（秒）
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300

# ==========================================
# 公告模块限制
# ==========================================
# 单管理员最多公告数
MAX_TOTAL_ANNOUNCEMENTS=10

# 单管理员最多可见公告数
MAX_VISIBLE_ANNOUNCEMENTS=5

# ==========================================
# 第三方翻译服务（可选）
# ==========================================
# 不使用牛翻 API 可留空
NIUTRANS_APPID=""
NIUTRANS_APIKEY=""

# ==========================================
# 化学结构缓存与检索（可选）
# ==========================================
# 关闭时隐藏结构检索入口；已缓存结构数据不会被删除
CHEM_STRUCTURE_FEATURE_ENABLED=false

# PubChem 只用于显式 CAS 解析/批量回填，不参与每次结构搜索
CHEM_RESOLVER_PUBCHEM_ENABLED=true

# PubChem 官方建议不要超过 5 req/s；默认保守使用 2 req/s
CHEM_PUBCHEM_RATE_LIMIT_PER_SECOND=2
CHEM_PUBCHEM_TIMEOUT_SECONDS=20
CHEM_PUBCHEM_MAX_RETRIES=3
CHEM_PUBCHEM_USER_AGENT="LabStorageManager/0.1.0"

# 结构检索默认最大返回数量
CHEM_STRUCTURE_SEARCH_MAX_RESULTS=100

# ==========================================
# 默认管理员（首次启动初始化）
# ==========================================
# 默认管理员用户名
DEFAULT_ADMIN_USERNAME="admin"

# 默认管理员密码（强烈建议首次启动后立即修改）
# [必填] 不填写会导致后端启动时初始化失败
DEFAULT_ADMIN_PASSWORD=""

# 默认管理员姓名
DEFAULT_ADMIN_FULL_NAME="系统管理员"

# ==========================================
# 企业微信智能机器人 + MCP（可选）
# ==========================================
# MCP 服务调用 LabStorageManager API 的地址
LSM_MCP_BASE_URL="http://127.0.0.1:8000/api"

# CLI 子进程请求超时（秒）
LSM_MCP_CLI_TIMEOUT=5

# 机器人访问本地 MCP Streamable HTTP 的地址
LSM_MCP_URL="http://127.0.0.1:8030/mcp"

# MiniMax Token Plan MCP；web_search 只用于化学名称/别名辅助确定 CAS，不接入图片理解
WECOM_AIBOT_WEB_SEARCH_ENABLED=true
MINIMAX_API_KEY=""
MINIMAX_API_HOST="https://api.minimaxi.com"
WECOM_AIBOT_MINIMAX_MCP_COMMAND="uvx"
WECOM_AIBOT_MINIMAX_MCP_TIMEOUT_SECONDS=25

# 企业微信智能机器人 WebSocket 模式
WECOM_AIBOT_MODE="websocket"
WECOM_AIBOT_BOT_ID=""
WECOM_AIBOT_SECRET=""

# 企业微信智能机器人 Webhook 模式
WECOM_AIBOT_TOKEN=""
WECOM_AIBOT_ENCODING_AES_KEY=""
WECOM_AIBOT_RECEIVE_ID=""

# LLM 意图规划器；不配置 API Key 时走规则兜底
WECOM_AIBOT_LLM_API_KEY=""
WECOM_AIBOT_LLM_MODEL="gpt-5"
WECOM_AIBOT_LLM_BASE_URL=""
WECOM_AIBOT_LLM_RESPONSES_URL="https://api.openai.com/v1/responses"
WECOM_AIBOT_LLM_TIMEOUT_SECONDS=8
WECOM_AIBOT_LLM_MAX_OUTPUT_TOKENS=400

# ==========================================
# 微信客服入口（个人微信用户，一对一会话）
# ==========================================
# 启动入口：poetry run python robot/run_wechat_kf_webhook.py
# 回调地址：https://your-domain.example.com/wechat/kf/callback
WECHAT_KF_CORP_ID=""
WECHAT_KF_SECRET=""
WECHAT_KF_TOKEN=""
WECHAT_KF_ENCODING_AES_KEY=""
WECHAT_KF_RECEIVE_ID=""
WECHAT_KF_OPEN_KFID=""
WECHAT_KF_WEBHOOK_HOST="0.0.0.0"
WECHAT_KF_WEBHOOK_PORT=8020
WECHAT_KF_BIND_BASE_URL=""
WECHAT_KF_BIND_TOKEN_TTL_MINUTES=10
WECHAT_KF_SYNC_LIMIT=100
WECHAT_KF_SYNC_MAX_PAGES=5
WECHAT_KF_RATE_LIMIT_MAX_MESSAGES=3
WECHAT_KF_RATE_LIMIT_WINDOW_SECONDS=10
