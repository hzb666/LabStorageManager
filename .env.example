# Lab Storage Manager - Environment Variables
# Copy this file to .env and modify values for production

# Application
APP_NAME="Lab Storage Manager"
DEBUG=true
ENV=development  # Set to "production" in production

# CORS (Cross-Origin Resource Sharing)
# Format: JSON array string, e.g. "[\"https://example.com\"]"
# Required in production - set to your frontend domain(s)
CORS_ORIGINS="[\"http://localhost:5173\", \"http://localhost:3000\"]"

# Database
DATABASE_URL="sqlite:///./lab_inventory.db?mode=wal"

# JWT Authentication
SECRET_KEY="your-secret-key-change-in-production"  # Required in production
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
MAX_IMAGE_WIDTH=800
MAX_IMAGE_HEIGHT=800
MAX_IMAGE_SIZE_KB=100

# Niutrans Translation API (for chemical name translation)
NIUTRANS_APPID=""
NIUTRANS_APIKEY=""

# Default Admin (required)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD=""  # Required - set a secure password
DEFAULT_ADMIN_FULL_NAME="系统管理员"
